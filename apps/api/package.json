{
  "name": "@rafay-pair/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist *.tsbuildinfo coverage",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "migrate": "tsx src/migrate.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run src/app.integration.test.ts src/database.integration.test.ts src/redis-rate-limit-store.integration.test.ts",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/websocket": "11.3.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/sdk-metrics": "2.11.0",
    "@opentelemetry/sdk-node": "0.222.0",
    "@rafay-pair/api-contracts": "workspace:*",
    "@rafay-pair/event-contracts": "workspace:*",
    "@rafay-pair/notifications": "workspace:*",
    "@rafay-pair/realtime": "workspace:*",
    "@rafay-pair/session-coordinator": "workspace:*",
    "argon2": "0.45.1",
    "fastify": "5.12.5",
    "google-auth-library": "11.1.0",
    "pg": "8.23.0",
    "redis": "6.2.1",
    "ws": "8.21.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.1",
    "tsx": "4.23.9",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
