{
  "name": "@rafay-pair/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": ">=11.20.0 <12"
  },
  "scripts": {
    "build": "node scripts/fetch-pose-model.mjs && tsc -b && vite build && node scripts/extract-source-maps.mjs && node scripts/verify-build.mjs",
    "clean": "rm -rf dist coverage .vite *.tsbuildinfo",
    "dev": "node scripts/fetch-pose-model.mjs && vite",
    "lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:live": "playwright test",
    "typecheck": "tsc -b --pretty false",
    "models": "node scripts/fetch-pose-model.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.1",
    "@rafay-pair/api-contracts": "workspace:*",
    "@rafay-pair/physiology-engine": "workspace:*",
    "@rafay-pair/pose-engine": "workspace:*",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "workbox-window": "7.4.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "fake-indexeddb": "6.2.6",
    "jsdom": "30.1.3",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "rollup": "4.64.12",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5",
    "workbox-core": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1"
  }
}
