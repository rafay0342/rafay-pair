# Runtime
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3000
PUBLIC_API_URL=http://localhost:3000
PUBLIC_WEB_ORIGIN=http://localhost:4173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
TRUST_PROXY=false

# Canonical durable and transient stores
DATABASE_URL=postgresql://rafay_pair:change-me@localhost:5432/rafay_pair?sslmode=disable
# Production containers set DATABASE_CA_CERT_PATH to a checksum-pinned AWS RDS root bundle.
REDIS_URL=redis://localhost:6379
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=rafay-pair
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY=change-me
OBJECT_STORAGE_SECRET_KEY=change-me

# Authentication and abuse controls
SESSION_PEPPER=replace-with-at-least-32-random-bytes
EMAIL_TOKEN_PEPPER=replace-with-at-least-32-random-bytes
# Exactly 32 random bytes encoded as unpadded base64url (43 characters).
DEVICE_TOKEN_ENCRYPTION_KEY=
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=RafayPair <no-reply@example.test>

# Realtime and notifications
REALTIME_MAX_CONNECTIONS_PER_USER=4
REALTIME_MAX_CONNECTIONS_PER_SESSION=2
REALTIME_CONNECTION_LEASE_TTL_SECONDS=45
REALTIME_MAX_TICKETS_PER_USER_WINDOW=12
REALTIME_MAX_TICKETS_PER_SESSION_WINDOW=6
REALTIME_REPLAY_PAGE_SIZE=100
REALTIME_MAX_BUFFERED_EVENTS=1000
REALTIME_MAX_SOCKET_BUFFER_BYTES=1048576
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_BUNDLE_ID=com.rafaypair.app
APNS_PRIVATE_KEY=
APNS_ENVIRONMENT=sandbox
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Android Play Integrity. The Cloud project number is a public Android build
# identifier; Google credentials are backend-only and may be a service account
# or an AWS workload-identity-federation external-account configuration.
PLAY_INTEGRITY_PACKAGE_NAME=com.rafaypair.android
PLAY_INTEGRITY_GOOGLE_CREDENTIALS_JSON=
# Comma-separated unpadded base64url SHA-256 signing certificate digests.
PLAY_INTEGRITY_ALLOWED_CERTIFICATE_SHA256_DIGESTS=
PLAY_INTEGRITY_MIN_VERSION_CODE=1
PLAY_INTEGRITY_PROVIDER_TIMEOUT_MS=8000
PLAY_INTEGRITY_MAX_TOKEN_AGE_MS=120000

# iOS App Attest. Team ID and bundle ID are public signing identifiers, not
# credentials. Keep release CFBundleVersion values and expected validation
# categories explicit so unexpected binaries produce elevated-risk telemetry.
APP_ATTEST_TEAM_ID=
APP_ATTEST_BUNDLE_ID=com.rafaypair.app
APP_ATTEST_ENVIRONMENT=development
APP_ATTEST_ALLOWED_VALIDATION_CATEGORIES=1
APP_ATTEST_ALLOWED_BUNDLE_VERSIONS=1

# Gate 4 planning only: these values are not loaded by the Gate 1 runtime.
# Qwen / Alibaba Cloud Model Studio is the exclusive planned AI provider.
# The master credential is backend-only and must come from a secret manager.
DASHSCOPE_API_KEY=
QWEN_REALTIME_MODEL=qwen3.5-omni-plus-realtime
QWEN_REGION=ap-southeast-1
QWEN_WORKSPACE_ID=

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=rafay-pair-api
