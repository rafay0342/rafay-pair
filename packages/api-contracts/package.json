{
  "name": "@rafay-pair/api-contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./openapi.yaml": "./openapi.yaml"
  },
  "files": [
    "dist",
    "openapi.yaml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src",
    "lint": "tsc -p tsconfig.json --noEmit",
    "validate": "redocly lint openapi.yaml --config redocly.yaml"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@redocly/cli": "2.45.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
